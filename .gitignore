# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Data
# The raw CSVs ARE committed on purpose, so the repository works standalone
# (a reviewer can run the notebooks immediately); `src/download_data.py` can
# recreate them from UCI. The 3 MB zip stays out.
data/raw/*.zip
# The processed CSVs are large intermediates - regenerated by notebook 02
data/processed/*.csv

# Trained models are committed so the Streamlit app works as cloned...
models/random_forest.joblib
# ...EXCEPT the Random Forest artifact: 728 MB (300 unlimited-depth trees on
# 80k rows), far above GitHub's 100 MB per-file limit. Recreate it by running
# notebook 02 (~15 minutes on a laptop): python src/run_notebook.py notebooks/02_preprocessing_and_modeling.ipynb

# Re-exported notebook artefacts (the .ipynb files already contain their outputs)
notebooks/*_files/
notebooks/*.md
*.html

# OS / editor noise
.DS_Store
Thumbs.db
