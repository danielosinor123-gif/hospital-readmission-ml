# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Data
# The raw CSVs ARE committed on purpose, so the repository works standalone
# (a reviewer can run the notebooks immediately); `src/download_data.py` can
# recreate them from UCI. The 3 MB zip stays out.
data/raw/*.zip
# The processed CSVs are large intermediates - regenerated by notebook 02
data/processed/*.csv

# Trained models are NOT committed: random_forest.joblib is 727 MB, far above
# GitHub's 100 MB file limit, and models are recreated by notebooks 02 and 03.
# Run `python src/run_notebook.py notebooks/02_preprocessing_and_modeling.ipynb`
# (~15 minutes on a laptop) to produce models/lightgbm.joblib for the app.
models/*.joblib

# Re-exported notebook artefacts (the .ipynb files already contain their outputs)
notebooks/*_files/
notebooks/*.md
*.html

# OS / editor noise
.DS_Store
Thumbs.db
